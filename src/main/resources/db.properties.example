# ====================================================================
# Jobify Database Configuration Example
# Copy this file to db.properties and set your local MySQL credentials
# ====================================================================

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/jobify_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.username=root
db.password=your_mysql_password_here

# Connection pool / timeout settings
db.pool.maxActive=20
db.pool.maxIdle=10
db.pool.timeout=30000
